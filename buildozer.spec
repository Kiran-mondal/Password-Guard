[app]
title = Password Guard
package.name = passwordguard
package.domain = org.kiran
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,sh,json,svg
version = 1.0
requirements = python3,kivy,kivymd,requests,cryptography,sqlite3
android.permissions = INTERNET, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE
orientation = portrait
osx.python_version = 3
osx.kivy_version = 2.1.0
fullscreen = 0
android.archs = arm64-v8a, armeabi-v7a
