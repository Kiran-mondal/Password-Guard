{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://noval-network.vercel.app https://*.vercel.app https://*.dpdns.org https://*.telegram.org;"
        }
      ]
    }
  ]
}
